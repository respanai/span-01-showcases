# Respan API key: https://platform.respan.ai/platform/api/api-keys
# Used for Span-01 and, unless ANTHROPIC_API_KEY is set, for Sonnet 5.5 through the Respan gateway.
RESPAN_API_KEY=

# Optional: call Sonnet 5.5 on the Anthropic API directly instead of through the Respan gateway.
# ANTHROPIC_API_KEY=

# Optional: span-01-pro (default) or span-01-free (Span-01 Lite).
# SPAN_MODEL=span-01-pro
